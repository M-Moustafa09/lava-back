{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Lavva;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  },
  "Jwt": {
    // Signs the store's own session token, issued by the admin login and by the SSO
    // token exchange (GET /api/sso/session-token). Per environment: this dev value is a
    // placeholder — production MUST override Secret in appsettings.Production.json with a
    // long random value that is not in source control. Issuer/Audience must match on both
    // sides of the token; they are the same in every environment.
    "Secret": "ThisIsASecretKeyForEFCoreDesignOnly",
    "Issuer": "Lavva",
    "Audience": "LavvaClient"
  },
  "LegacyCrm": {
    "Enabled": false,
    "BaseUrl": "https://localhost:7079",
    "ApiKey": "lavva-crm-sync-token-dev",
    "ChatApiKey": "crm-to-lavva-incoming-token-dev",
    "IncomingKey": "crm-to-lavva-incoming-token-dev",
    "TimeoutSeconds": 15,
    "SyncIntervalSeconds": 15,
    // G1.1: public, browser-facing CRM domain that hosts the shipment-tracking pages. This app
    // 301-redirects /t/* and /Order/TrackLoxxKingShipment/* here. This is NOT BaseUrl above
    // (that is the server-to-server API origin, e.g. localhost in dev). Per environment:
    // production CRM = https://luxira.org; a test store should override this to the test CRM
    // (e.g. https://test.luxira.org) in that environment's appsettings.
    "PublicTrackingBaseUrl": "https://luxira.org",
    // Store visits → CRM (StoreVisitCrmForwarder → POST {BaseUrl}/api/StoreVisits/Incoming, same key as
    // ChatApiKey). Each visit becomes a CRM popup + «زيارات المتجر» entry + an email to the owner.
    // Production: true. A developer store: false unless a local CRM is running (else every page load
    // tries the CRM). Needs Enabled above to be true as well.
    "ForwardStoreVisits": false
  },
  "Sso": {
    "RsaPublicKeyPath": "App_Data/Keys/sso_public_key.pem",
    "Issuer": "LuxiraCRM",
    "Audience": "LavvaApp",
    "ClockSkewSeconds": 30
  }
}