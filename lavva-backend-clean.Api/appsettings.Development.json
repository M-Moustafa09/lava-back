{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "App": {
    "BaseUrl": "http://localhost:5070"
  },
  // The local CRM (luxira-test) runs on :5099; its AcceptedTokens must hold ApiKey, and its
  // LavvaIntegration:ApiKey must equal IncomingKey. Dev-only values.
  "LegacyCrm": {
    "Enabled": true,
    "BaseUrl": "http://localhost:5099",
    "ApiKey": "lavva-crm-sync-token-dev",
    "ChatApiKey": "crm-to-lavva-incoming-token-dev",
    "IncomingKey": "crm-to-lavva-incoming-token-dev",
    "PublicTrackingBaseUrl": "http://localhost:5099",
    "ForwardStoreVisits": false
  },
  "Seeding": {
    "Skip": [ "ReviewSeeder", "FavoriteSeeder", "NotificationSeeder", "OrderSeeder", "SupportSeeder", "SiteVisitSeeder" ]
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=Lavva;Trusted_Connection=True;TrustServerCertificate=True;MultipleActiveResultSets=true"
  }
}